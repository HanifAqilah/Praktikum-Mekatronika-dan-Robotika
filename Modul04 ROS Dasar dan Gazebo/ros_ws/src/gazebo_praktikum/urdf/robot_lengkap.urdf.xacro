<?xml version="1.0"?>
<!--
  XACRO Robot Lengkap dengan:
  - Sensor kamera (camera plugin)
  - Sensor LIDAR (laser scan plugin)
  - Differential drive controller (ros_control)
  
  Digunakan pada Percobaan 5, 6, 7
-->
<robot name="robot_lengkap" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================================================ -->
  <!-- XACRO Properties -->
  <!-- ============================================================ -->
  <xacro:property name="base_mass"     value="1.5"/>
  <xacro:property name="base_lebar"    value="0.20"/>
  <xacro:property name="base_panjang"  value="0.25"/>
  <xacro:property name="base_tinggi"   value="0.07"/>

  <xacro:property name="roda_radius"   value="0.065"/>
  <xacro:property name="roda_lebar"    value="0.03"/>
  <xacro:property name="roda_jarak"    value="0.115"/>

  <!-- ============================================================ -->
  <!-- XACRO Macro: Roda -->
  <!-- ============================================================ -->
  <xacro:macro name="roda" params="nama sisi offset_y">
    <link name="roda_${nama}">
      <inertial>
        <mass value="0.2"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.000526" ixy="0" ixz="0"
                 iyy="0.000526" iyz="0" izz="0.001"/>
      </inertial>
      <collision>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
        <geometry>
          <cylinder radius="${roda_radius}" length="${roda_lebar}"/>
        </geometry>
      </collision>
      <visual>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
        <geometry>
          <cylinder radius="${roda_radius}" length="${roda_lebar}"/>
        </geometry>
        <material name="hitam">
          <color rgba="0 0 0 1"/>
        </material>
      </visual>
    </link>

    <joint name="joint_roda_${nama}" type="continuous">
      <parent link="base_link"/>
      <child link="roda_${nama}"/>
      <origin xyz="0.0 ${offset_y} ${-base_tinggi/2 - 0.0025}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.1"/>
    </joint>

    <gazebo reference="roda_${nama}">
      <material>Gazebo/Black</material>
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <kp>1e6</kp>
      <kd>100.0</kd>
    </gazebo>
  </xacro:macro>

  <!-- ============================================================ -->
  <!-- Base links -->
  <!-- ============================================================ -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${roda_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <inertial>
      <mass value="${base_mass}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.010416" ixy="0" ixz="0"
               iyy="0.010416" iyz="0" izz="0.018750"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_panjang} ${base_lebar} ${base_tinggi}"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_panjang} ${base_lebar} ${base_tinggi}"/>
      </geometry>
      <material name="biru">
        <color rgba="0.0 0.0 0.8 1.0"/>
      </material>
    </visual>
  </link>

  <!-- Gunakan macro roda -->
  <xacro:roda nama="kiri"    sisi="kiri"   offset_y="${roda_jarak}"/>
  <xacro:roda nama="kanan"   sisi="kanan"  offset_y="${-roda_jarak}"/>

  <!-- Caster wheel belakang -->
  <link name="caster_roda">
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.00004" ixy="0" ixz="0"
               iyy="0.00004" iyz="0" izz="0.00004"/>
    </inertial>
    <collision>
      <geometry><sphere radius="0.0325"/></geometry>
    </collision>
    <visual>
      <geometry><sphere radius="0.0325"/></geometry>
      <material name="abu_abu"><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>
  </link>
  <joint name="joint_caster" type="fixed">
    <parent link="base_link"/>
    <child link="caster_roda"/>
    <origin xyz="-0.10 0 ${-base_tinggi/2 - 0.0325 + 0.0025}" rpy="0 0 0"/>
  </joint>
  <gazebo reference="caster_roda">
    <material>Gazebo/Grey</material>
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <!-- Caster wheel depan (mencegah robot jatuh ke depan saat belok) -->
  <link name="caster_depan">
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.00004" ixy="0" ixz="0"
               iyy="0.00004" iyz="0" izz="0.00004"/>
    </inertial>
    <collision>
      <geometry><sphere radius="0.0325"/></geometry>
    </collision>
    <visual>
      <geometry><sphere radius="0.0325"/></geometry>
      <material name="abu_abu"/>
    </visual>
  </link>
  <joint name="joint_caster_depan" type="fixed">
    <parent link="base_link"/>
    <child link="caster_depan"/>
    <origin xyz="0.10 0 ${-base_tinggi/2 - 0.0325 + 0.0025}" rpy="0 0 0"/>
  </joint>
  <gazebo reference="caster_depan">
    <material>Gazebo/Grey</material>
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <!-- ============================================================ -->
  <!-- Platform sensor (tepat di atas badan) -->
  <!-- ============================================================ -->
  <link name="sensor_platform">
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0"
               iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <collision>
      <geometry><box size="0.1 0.1 0.02"/></geometry>
    </collision>
    <visual>
      <geometry><box size="0.1 0.1 0.02"/></geometry>
      <material name="abu_abu_tua"><color rgba="0.3 0.3 0.3 1"/></material>
    </visual>
  </link>
  <joint name="joint_sensor_platform" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_platform"/>
    <origin xyz="0 0 ${base_tinggi/2 + 0.01}" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================ -->
  <!-- SENSOR: Kamera -->
  <!-- ============================================================ -->
  <link name="camera_link">
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0"
               iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <collision>
      <geometry><box size="0.03 0.05 0.03"/></geometry>
    </collision>
    <visual>
      <geometry><box size="0.03 0.05 0.03"/></geometry>
      <material name="hitam_kamera"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
  </link>
  <joint name="joint_camera" type="fixed">
    <parent link="sensor_platform"/>
    <child link="camera_link"/>
    <origin xyz="0.05 0 0.03" rpy="0 0.1 0"/>
  </joint>

  <!-- Gazebo camera plugin -->
  <gazebo reference="camera_link">
    <sensor name="kamera_depan" type="camera">
      <update_rate>30.0</update_rate>
      <camera name="head">
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>300</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <remapping>image_raw:=camera/image_raw</remapping>
          <remapping>camera_info:=camera/camera_info</remapping>
        </ros>
        <camera_name>camera</camera_name>
        <frame_name>camera_link</frame_name>
        <hack_baseline>0.07</hack_baseline>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ============================================================ -->
  <!-- SENSOR: LIDAR / Laser Scan -->
  <!-- ============================================================ -->
  <link name="lidar_link">
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0"
               iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <collision>
      <geometry><cylinder radius="0.04" length="0.07"/></geometry>
    </collision>
    <visual>
      <geometry><cylinder radius="0.04" length="0.07"/></geometry>
      <material name="lidar_color"><color rgba="0.0 0.8 0.0 1"/></material>
    </visual>
  </link>
  <joint name="joint_lidar" type="fixed">
    <parent link="sensor_platform"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>

  <!-- Gazebo LIDAR plugin -->
  <gazebo reference="lidar_link">
    <sensor name="laser_sensor" type="ray">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.10</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="gazebo_ros_laser" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ============================================================ -->
  <!-- Gazebo: Differential Drive Plugin -->
  <!-- ============================================================ -->
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
      </ros>
      <update_rate>50</update_rate>
      <left_joint>joint_roda_kiri</left_joint>
      <right_joint>joint_roda_kanan</right_joint>
      <wheel_separation>${2 * roda_jarak}</wheel_separation>
      <wheel_diameter>${2 * roda_radius}</wheel_diameter>
      <max_wheel_torque>20</max_wheel_torque>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
  </gazebo>

  <!-- ============================================================ -->
  <!-- Gazebo: Warna base_link -->
  <!-- ============================================================ -->
  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
  </gazebo>
  <gazebo reference="sensor_platform">
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  <gazebo reference="camera_link">
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="lidar_link">
    <material>Gazebo/Green</material>
  </gazebo>

</robot>
