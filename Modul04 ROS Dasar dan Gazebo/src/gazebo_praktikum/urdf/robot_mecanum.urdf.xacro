<?xml version="1.0"?>
<!--
  XACRO Robot Mecanum 4WD (nexus_4wd_mecanum)
  Percobaan 18-20

  Berdasarkan nexus_4wd_mecanum_simulator/nexus_4wd_mecanum_description
  Mesh: gazebo_praktikum/meshes/nexus/
  Gerakan: libgazebo_ros_planar_move.so (ROS2, menggantikan libnexus_ros_force_based_move.so)
  Sensor ultrasonik URM04: visual only (left, front, right, rear)
  LIDAR 360°: libgazebo_ros_ray_sensor.so → /scan
-->
<robot name="robot_mecanum" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="PI"           value="3.1415926535897931"/>
  <xacro:property name="wheel_radius" value="0.050"/>
  <xacro:property name="wheel_width"  value="0.0505"/>
  <xacro:property name="pkg"          value="gazebo_praktikum"/>

  <!-- ── Materials ─────────────────────────────────────────────────── -->
  <material name="mec_yellow">    <color rgba="0.8 0.8 0.0 1.0"/></material>
  <material name="mec_black">     <color rgba="0.15 0.15 0.15 1.0"/></material>
  <material name="mec_dark_grey"> <color rgba="0.2 0.2 0.2 1.0"/></material>
  <material name="mec_light_grey"><color rgba="0.4 0.4 0.4 1.0"/></material>

  <!-- ── Base ──────────────────────────────────────────────────────── -->
  <link name="base_footprint"/>

  <joint name="base_link_joint" type="fixed">
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <parent link="base_footprint"/>
    <child  link="base_link"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://${pkg}/meshes/nexus/nexus_base_link.STL"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="mec_yellow"/>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://${pkg}/meshes/nexus/nexus_base_link_collision.STL"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-0.01103 0 0.002" rpy="0 0 0"/>
      <mass value="2.844"/>
      <inertia ixx="0.018819942" ixy="0"          ixz="-0.000101519"
               iyy="0.057333716" iyz="0"
               izz="0.074201740"/>
    </inertial>
  </link>

  <!-- ── Wheel shaft + wheel macro ─────────────────────────────────── -->
  <!--
    shaft_xyz  : posisi shaft dari base_link
    shaft_rpy  : kiri=0,0,0 ; kanan=PI,0,0 (membalik orientasi wheel shaft)
    wheel_mesh : mecanum_wheel_left.STL atau mecanum_wheel_right.STL
  -->
  <xacro:macro name="mecanum_wheel" params="prefix shaft_xyz shaft_rpy wheel_mesh">

    <joint name="${prefix}_wheel_shaft_joint" type="fixed">
      <origin xyz="${shaft_xyz}" rpy="${shaft_rpy}"/>
      <parent link="base_link"/>
      <child  link="${prefix}_wheel_shaft"/>
    </joint>

    <link name="${prefix}_wheel_shaft">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://${pkg}/meshes/nexus/wheel_shaft.STL"
                scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="mec_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://${pkg}/meshes/nexus/wheel_shaft.STL"
                scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0.01221 0" rpy="0 0 0"/>
        <mass value="0.055"/>
        <inertia ixx="0.000021370" ixy="0" ixz="0"
                 iyy="0.000009966" iyz="0"
                 izz="0.000021370"/>
      </inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <origin xyz="0 0.042 0" rpy="0 0 0"/>
      <parent link="${prefix}_wheel_shaft"/>
      <child  link="${prefix}_wheel"/>
      <axis xyz="0 1 0"/>
    </joint>

    <link name="${prefix}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://${pkg}/meshes/nexus/${wheel_mesh}"
                scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="mec_light_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
        <mass value="0.3844"/>
        <inertia ixx="0.000324824" ixy="0" ixz="0"
                 iyy="0.000480000" iyz="0"
                 izz="0.000324824"/>
      </inertial>
    </link>

    <gazebo reference="${prefix}_wheel_shaft">
      <material>Gazebo/Black</material>
    </gazebo>
    <gazebo reference="${prefix}_wheel">
      <material>Gazebo/Grey</material>
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
    </gazebo>

  </xacro:macro>

  <!-- 4 roda mecanum sesuai nexus_4wd_mecanum.xacro -->
  <xacro:mecanum_wheel prefix="upper_left"
    shaft_xyz="0.150 0.108 0.0"   shaft_rpy="0 0 0"
    wheel_mesh="mecanum_wheel_left.STL"/>

  <xacro:mecanum_wheel prefix="lower_left"
    shaft_xyz="-0.150 0.108 0.0"  shaft_rpy="0 0 0"
    wheel_mesh="mecanum_wheel_right.STL"/>

  <xacro:mecanum_wheel prefix="upper_right"
    shaft_xyz="0.150 -0.108 0.0"  shaft_rpy="${PI} 0 0"
    wheel_mesh="mecanum_wheel_right.STL"/>

  <xacro:mecanum_wheel prefix="lower_right"
    shaft_xyz="-0.150 -0.108 0.0" shaft_rpy="${PI} 0 0"
    wheel_mesh="mecanum_wheel_left.STL"/>

  <!-- ── Sensor URM04 ultrasonik (visual only) ─────────────────────── -->
  <joint name="left_sensor_joint" type="fixed">
    <origin xyz="0 0.108 0.010" rpy="0 0 ${PI/2}"/>
    <parent link="base_link"/>
    <child  link="left_sensor"/>
  </joint>
  <link name="left_sensor">
    <visual>
      <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
      <geometry>
        <mesh filename="package://${pkg}/meshes/nexus/urm04.STL"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="mec_black"/>
    </visual>
  </link>

  <joint name="front_sensor_joint" type="fixed">
    <origin xyz="0.205 0 0.010" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child  link="front_sensor"/>
  </joint>
  <link name="front_sensor">
    <visual>
      <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
      <geometry>
        <mesh filename="package://${pkg}/meshes/nexus/urm04.STL"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="mec_black"/>
    </visual>
  </link>

  <joint name="right_sensor_joint" type="fixed">
    <origin xyz="0 -0.108 0.010" rpy="0 0 ${-PI/2}"/>
    <parent link="base_link"/>
    <child  link="right_sensor"/>
  </joint>
  <link name="right_sensor">
    <visual>
      <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
      <geometry>
        <mesh filename="package://${pkg}/meshes/nexus/urm04.STL"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="mec_black"/>
    </visual>
  </link>

  <joint name="rear_sensor_joint" type="fixed">
    <origin xyz="-0.201 0 0.010" rpy="0 0 ${PI}"/>
    <parent link="base_link"/>
    <child  link="rear_sensor"/>
  </joint>
  <link name="rear_sensor">
    <visual>
      <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
      <geometry>
        <mesh filename="package://${pkg}/meshes/nexus/urm04.STL"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="mec_black"/>
    </visual>
  </link>

  <!-- ── LIDAR 360° ───────────────────────────────────────────────── -->
  <joint name="lidar_joint" type="fixed">
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child  link="lidar_link"/>
  </joint>

  <link name="lidar_link">
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.000001" ixy="0" ixz="0"
               iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry><cylinder radius="0.04" length="0.04"/></geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0"/>
      <geometry><cylinder radius="0.04" length="0.04"/></geometry>
      <material name="mec_dark_grey"/>
    </visual>
  </link>

  <!-- ── Gazebo: colors ───────────────────────────────────────────── -->
  <gazebo reference="base_footprint">
    <material>Gazebo/Yellow</material>
    <gravity>true</gravity>
  </gazebo>
  <gazebo reference="base_link">
    <material>Gazebo/Yellow</material>
  </gazebo>
  <gazebo reference="left_sensor"><material>Gazebo/Black</material></gazebo>
  <gazebo reference="front_sensor"><material>Gazebo/Black</material></gazebo>
  <gazebo reference="right_sensor"><material>Gazebo/Black</material></gazebo>
  <gazebo reference="rear_sensor"><material>Gazebo/Black</material></gazebo>

  <!-- ── Plugin: Planar Move (menggantikan libnexus_ros_force_based_move) ── -->
  <gazebo>
    <plugin name="gazebo_ros_planar_move" filename="libgazebo_ros_planar_move.so">
      <ros>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
      </ros>
      <update_rate>50</update_rate>
      <publish_rate>20</publish_rate>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
  </gazebo>

  <!-- ── Plugin: LIDAR ────────────────────────────────────────────── -->
  <gazebo reference="lidar_link">
    <material>Gazebo/DarkGrey</material>
    <sensor name="lidar_sensor" type="ray">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.20</min>
          <max>8.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

</robot>
