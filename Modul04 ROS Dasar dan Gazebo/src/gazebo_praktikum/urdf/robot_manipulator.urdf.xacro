<?xml version="1.0"?>
<!--
  URDF Robot Manipulator (Lengan Robot 3-DOF)
  Percobaan 8: Simulasi robot manipulator di Gazebo
  
  Struktur:
    base_link -> link1 (revolute, axis Z) -> link2 (revolute, axis Y) -> link3 (revolute, axis Y) -> end_effector
-->
<robot name="robot_manipulator" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Material -->
  <material name="abu_abu">  <color rgba="0.5 0.5 0.5 1.0"/></material>
  <material name="kuning">   <color rgba="0.9 0.7 0.0 1.0"/></material>
  <material name="merah">    <color rgba="0.8 0.0 0.0 1.0"/></material>
  <material name="biru">     <color rgba="0.0 0.0 0.8 1.0"/></material>
  <material name="hitam">    <color rgba="0.1 0.1 0.1 1.0"/></material>

  <!-- ============================================================ -->
  <!-- BASE -->
  <!-- ============================================================ -->
  <link name="world"/>

  <joint name="joint_base_world" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <inertial>
      <mass value="2.0"/>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><cylinder radius="0.1" length="0.1"/></geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><cylinder radius="0.1" length="0.1"/></geometry>
      <material name="abu_abu"/>
    </visual>
  </link>

  <!-- ============================================================ -->
  <!-- JOINT 1: Rotasi horizontal (yaw) -->
  <!-- ============================================================ -->
  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="100" velocity="1.0"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <link name="link_1">
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.001"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry><box size="0.06 0.06 0.30"/></geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry><box size="0.06 0.06 0.30"/></geometry>
      <material name="kuning"/>
    </visual>
  </link>

  <!-- ============================================================ -->
  <!-- JOINT 2: Rotasi pitch bahu -->
  <!-- ============================================================ -->
  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0 0 0.30" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5707" upper="1.5707" effort="80" velocity="1.0"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <link name="link_2">
    <inertial>
      <mass value="0.3"/>
      <origin xyz="0.125 0 0" rpy="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <collision>
      <origin xyz="0.125 0 0" rpy="0 1.5707 0"/>
      <geometry><cylinder radius="0.04" length="0.25"/></geometry>
    </collision>
    <visual>
      <origin xyz="0.125 0 0" rpy="0 1.5707 0"/>
      <geometry><cylinder radius="0.04" length="0.25"/></geometry>
      <material name="merah"/>
    </visual>
  </link>

  <!-- ============================================================ -->
  <!-- JOINT 3: Rotasi pitch siku -->
  <!-- ============================================================ -->
  <joint name="joint_3" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="0.25 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0944" upper="0" effort="50" velocity="1.5"/>
    <dynamics damping="0.3" friction="0.05"/>
  </joint>

  <link name="link_3">
    <inertial>
      <mass value="0.2"/>
      <origin xyz="0.1 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/>
    </inertial>
    <collision>
      <origin xyz="0.1 0 0" rpy="0 1.5707 0"/>
      <geometry><cylinder radius="0.03" length="0.20"/></geometry>
    </collision>
    <visual>
      <origin xyz="0.1 0 0" rpy="0 1.5707 0"/>
      <geometry><cylinder radius="0.03" length="0.20"/></geometry>
      <material name="biru"/>
    </visual>
  </link>

  <!-- ============================================================ -->
  <!-- End Effector -->
  <!-- ============================================================ -->
  <joint name="joint_end_effector" type="fixed">
    <parent link="link_3"/>
    <child link="end_effector"/>
    <origin xyz="0.20 0 0" rpy="0 0 0"/>
  </joint>

  <link name="end_effector">
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <collision>
      <geometry><sphere radius="0.03"/></geometry>
    </collision>
    <visual>
      <geometry><sphere radius="0.03"/></geometry>
      <material name="hitam"/>
    </visual>
  </link>

  <!-- ============================================================ -->
  <!-- ros2_control interface: hardware + joints -->
  <!-- Menggunakan mock_components agar tidak perlu paket gazebo_ros2_control -->
  <!-- Gerakan joint tampil di RViz2; Gazebo menampilkan model statis -->
  <!-- ============================================================ -->
  <ros2_control name="ManipulatorSystem" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
    </hardware>
    <joint name="joint_1">
      <command_interface name="position">
        <param name="min">-3.14159</param>
        <param name="max"> 3.14159</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_2">
      <command_interface name="position">
        <param name="min">-1.5707</param>
        <param name="max"> 1.5707</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_3">
      <command_interface name="position">
        <param name="min">-2.0944</param>
        <param name="max"> 0.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- Warna Gazebo -->
  <gazebo reference="base_link">  <material>Gazebo/Grey</material>   </gazebo>
  <gazebo reference="link_1">     <material>Gazebo/Yellow</material>  </gazebo>
  <gazebo reference="link_2">     <material>Gazebo/Red</material>     </gazebo>
  <gazebo reference="link_3">     <material>Gazebo/Blue</material>    </gazebo>
  <gazebo reference="end_effector"><material>Gazebo/Black</material>  </gazebo>

</robot>
