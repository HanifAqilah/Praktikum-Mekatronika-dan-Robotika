<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="magician">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import magician urdf file -->
    <xacro:include filename="$(find dobot_description)/model/magician_standalone.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="magician.ros2_control.xacro" />


    <xacro:magician_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
