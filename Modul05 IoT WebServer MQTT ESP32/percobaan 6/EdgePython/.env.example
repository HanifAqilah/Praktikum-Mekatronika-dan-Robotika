# ─── Edge Python Subscriber – Environment Variables ──────────────────────────
# Copy this file to .env and fill in your values.

# MQTT broker (IP/hostname of the machine running Mosquitto)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# Authentication (leave blank if no auth)
MQTT_USERNAME=
MQTT_PASSWORD=

# Unique client ID for this subscriber
MQTT_CLIENT_ID=edge-sub-percobaan6

# Topic wildcard to subscribe to
SUBSCRIBE_TOPIC=esp32/#

# Temperature threshold for red alert (Celsius)
SUHU_ALERT_THRESHOLD=35.0

# Log file settings
LOG_FILE=edge_log.txt
LOG_MAX_BYTES=1048576   # 1 MB
LOG_BACKUP_COUNT=3
