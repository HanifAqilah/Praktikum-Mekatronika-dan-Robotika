# ─── Backend Environment Variables ────────────────────────────────────────────
# Copy this file to .env and fill in your values.

# Port the Express HTTP server listens on
PORT=3006

# MQTT broker connection URL
# Examples:
#   mqtt://localhost:1883         (local Mosquitto, no auth)
#   mqtt://192.168.1.100:1883     (LAN broker)
#   mqtts://broker.hivemq.com:8883 (TLS)
MQTT_BROKER_URL=mqtt://localhost:1883

# MQTT credentials (leave blank if broker has no auth)
MQTT_USERNAME=
MQTT_PASSWORD=
